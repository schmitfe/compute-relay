# Minimal synthetic test schema; this is not a production Samba schema.
# Samba attribute names/OIDs are defined by the Samba project:
# https://github.com/samba-team/samba/blob/master/examples/LDAP/samba.schema
# No Samba password-hash attributes or institutional schema/data are copied.
attributetype ( 1.3.6.1.4.1.7165.2.1.26 NAME 'sambaAcctFlags'
    EQUALITY caseIgnoreIA5Match
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.26{16} SINGLE-VALUE )
attributetype ( 1.3.6.1.4.1.7165.2.1.20 NAME 'sambaSID'
    EQUALITY caseIgnoreIA5Match
    SYNTAX 1.3.6.1.4.1.1466.115.121.1.26{64} SINGLE-VALUE )
objectclass ( 1.3.6.1.4.1.7165.2.2.6 NAME 'sambaSamAccount'
    SUP top AUXILIARY MUST ( uid $ sambaSID ) MAY sambaAcctFlags )
