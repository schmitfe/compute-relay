{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compute-relay.invalid/contracts/job-request.schema.json",
  "title": "Compute Relay version one job request",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "connection_id", "name", "command", "environment", "resources", "files", "outputs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "connection_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "name": {"$ref": "common.schema.json#/$defs/name"},
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["interpreter", "script", "arguments"],
      "properties": {
        "interpreter": {"enum": ["python3", "bash"]},
        "script": {"$ref": "common.schema.json#/$defs/relativePath"},
        "arguments": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 4096, "not": {"pattern": "\u0000"}}}
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision_sha256"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/uuid"},
        "revision_sha256": {"$ref": "common.schema.json#/$defs/digest"}
      }
    },
    "resources": {"$ref": "common.schema.json#/$defs/resources"},
    "slurm": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "partition": {"$ref": "common.schema.json#/$defs/name"},
        "account": {"$ref": "common.schema.json#/$defs/name"},
        "qos": {"$ref": "common.schema.json#/$defs/name"}
      }
    },
    "files": {"type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/file"}},
    "outputs": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/relativePath"}}
  }
}
