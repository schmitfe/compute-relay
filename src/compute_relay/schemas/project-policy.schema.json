{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compute-relay.invalid/contracts/project-policy.schema.json",
  "title": "Compute Relay version one project policy",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_id", "revision", "mode", "allowed_connection_ids", "allowed_environment_revision_sha256", "allowed_gpu_types", "per_job_limits", "max_active_jobs", "allowance", "admission_expires_at"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "project_id": {"$ref": "common.schema.json#/$defs/uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "mode": {"enum": ["approval_required", "budgeted", "mixed"]},
    "allowed_connection_ids": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/uuid"}},
    "allowed_environment_revision_sha256": {"type": "array", "minItems": 0, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/digest"}},
    "allowed_gpu_types": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/name"}},
    "allow_untyped_gpus": {"type": "boolean", "default": false},
    "per_job_limits": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu_cores", "gpu_devices", "memory_mib", "time_limit_seconds"],
      "properties": {
        "cpu_cores": {"type": "integer", "minimum": 1, "maximum": 1024},
        "gpu_devices": {"type": "integer", "minimum": 0, "maximum": 16},
        "memory_mib": {"type": "integer", "minimum": 128, "maximum": 16777216},
        "time_limit_seconds": {"type": "integer", "minimum": 60, "maximum": 604800, "multipleOf": 60}
      }
    },
    "max_active_jobs": {"type": "integer", "minimum": 1, "maximum": 1000},
    "max_total_jobs": {"type": "integer", "minimum": 0, "maximum": 1000000, "default": 1000},
    "allowance": {"$ref": "common.schema.json#/$defs/usageVector"},
    "admission_expires_at": {"type": "string", "format": "date-time"}
  }
}
