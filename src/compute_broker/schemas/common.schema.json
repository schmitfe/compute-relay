{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://compute-broker.invalid/contracts/common.schema.json",
  "title": "Compute Broker shared definitions",
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$"},
    "relativePath": {
      "type": "string", "minLength": 1, "maxLength": 240,
      "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9_./-]*[A-Za-z0-9_.-])?$",
      "not": {"pattern": "(^|/)\\.{1,2}(/|$)|//"}
    },
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "executable"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 104857600},
        "executable": {"type": "boolean"}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["nodes", "cpus", "gpus", "memory_mib", "time_limit_seconds"],
      "properties": {
        "nodes": {"const": 1},
        "cpus": {"type": "integer", "minimum": 1, "maximum": 1024},
        "gpus": {"type": "integer", "minimum": 0, "maximum": 16},
        "gpu_type": {"$ref": "#/$defs/name"},
        "memory_mib": {"type": "integer", "minimum": 128, "maximum": 16777216},
        "time_limit_seconds": {"type": "integer", "minimum": 60, "maximum": 604800, "multipleOf": 60}
      },
      "allOf": [
        {"if": {"properties": {"gpus": {"minimum": 1}}, "required": ["gpus"]}, "then": {"required": ["gpu_type"]}},
        {"if": {"properties": {"gpus": {"const": 0}}, "required": ["gpus"]}, "then": {"not": {"required": ["gpu_type"]}}}
      ]
    },
    "usageVector": {
      "type": "object", "additionalProperties": false,
      "required": ["cpu_core_seconds", "gpu_device_seconds"],
      "properties": {
        "cpu_core_seconds": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "gpu_device_seconds": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      }
    }
  }
}
